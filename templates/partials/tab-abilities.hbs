{{!-- ── Abilities ── --}}
<div class="tab" data-tab="abilities" data-group="primary">
  {{#each items}}
    {{#if (eq type "ability")}}
    <div class="ability-item" data-item-id="{{_id}}">
      <div class="ability-header">
        <div class="ability-name">{{name}}</div>
        {{#if system.basic.cost}}
        <div class="ability-cost">{{system.basic.cost}} {{system.basic.pool}}</div>
        {{/if}}
        <div class="ability-item-controls">
          <button type="button" class="ability-roll roll-btn" data-item-id="{{id}}" title="Roll">⚂</button>
          <button type="button" class="ability-edit" data-item-id="{{_id}}" title="Edit">✎</button>
          <button type="button" class="item-delete-ability" data-item-id="{{_id}}" title="Delete">🗑</button>
        </div>
      </div>
      <div class="ability-desc">{{{system.description}}}</div>
    </div>
    {{/if}}
  {{/each}}

  {{!-- Add ability form --}}
  <div class="add-ability-form card">
    <div class="section-title">Add Ability</div>

    <div class="ability-form-row">
      <div class="ability-form-field" style="flex:2;">
        <label>Name</label>
        <input type="text" id="new-ability-name" placeholder="Ability name..." />
      </div>
      <div class="ability-form-field" style="flex:1;">
        <label>Cost</label>
        <input type="number" id="new-ability-cost" placeholder="0" min="0" style="width:100%;" />
      </div>
      <div class="ability-form-field" style="flex:1;">
        <label>Pool</label>
        <select id="new-ability-pool">
          <option value="">— None —</option>
          <option value="Might">Might</option>
          <option value="Speed">Speed</option>
          <option value="Intellect">Intellect</option>
        </select>
      </div>
    </div>

    <div class="ability-form-field" style="margin-top:8px;">
      <label>Description</label>
      <textarea id="new-ability-desc" placeholder="What does it do?"></textarea>
    </div>

    <button type="button" class="btn-add-ability">+ Add Ability</button>
  </div>
</div>