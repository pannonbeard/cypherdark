<form class="cypherdark editable" autocomplete="off">

  {{> cypherdark-header}}

  {{!-- ── Tabs ── --}}
  <nav class="sheet-tabs tabs" data-group="primary">
    <a class="item" data-tab="stats">Stats</a>
    <a class="item" data-tab="skills">Skills</a>
    <a class="item" data-tab="abilities">Abilities</a>
    <a class="item" data-tab="cyphers">Cyphers</a>
    <a class="item" data-tab="equipment">Equipment</a>
    <a class="item" data-tab="notes">Notes</a>
  </nav>

  <section class="sheet-body">
    {{> cypherdark-tab-stats}}
    {{> cypherdark-tab-skills}}
    {{> cypherdark-tab-abilities}}
    {{> cypherdark-tab-cyphers}}
    {{> cypherdark-tab-equipment}}
    {{> cypherdark-tab-notes}}
  </section>

</form>