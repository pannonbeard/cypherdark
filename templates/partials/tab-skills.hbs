{{!-- ── Skills ── --}}
<div class="tab" data-tab="skills" data-group="primary">
  <div class="skills-legend">
    <span class="inability">✕ Inability</span>
    <span>● Trained</span>
    <span>●● Specialized</span>
  </div>

  {{#each items}}
    {{#if (eq type "skill")}}
    <div class="skill-row {{#if (eq system.basic.rating 'Inability')}}inability{{/if}}" data-item-id="{{id}}">
      <span class="skill-name" style="flex:1;">{{name}}</span>
      <span class="skill-level-badge">
        {{#if (eq system.basic.rating "Inability")}}Inability
        {{else if (eq system.basic.rating "Specialized")}}Specialized
        {{else if (eq system.basic.rating "Trained")}}Trained
        {{else}}Unskilled{{/if}}
      </span>
      <div class="skill-controls">
        <button type="button" class="skill-roll roll-btn" data-item-id="{{_id}}" title="Roll">⚂</button>
        <button type="button" class="skill-cycle" data-item-id="{{_id}}" title="Cycle level">⟳</button>
        <button type="button" class="skill-inability" data-item-id="{{_id}}" title="Toggle inability">✕</button>
        <button type="button" class="item-delete" data-item-id="{{_id}}" title="Delete">🗑</button>
      </div>
    </div>
    {{/if}}
  {{/each}}

  <div class="add-row">
    <input type="text" id="new-skill-name" placeholder="New skill..." />
    <button type="button" class="btn-add-skill">+ Add Skill</button>
  </div>
</div>