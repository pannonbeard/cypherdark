<div class="tab" data-tab="equipment" data-group="primary">

  {{!-- Attacks section --}}
  {{#each items}}
    {{#if (eq type "attack")}}
    {{#if @first}}<div class="section-title">Attacks</div>{{/if}}
    <div class="equipment-row" data-item-id="{{_id}}">
      <span class="eq-name">{{name}}</span>
      <span class="eq-qty" style="color:var(--might);">{{system.basic.damage}} dmg</span>
      <span class="eq-qty">{{system.basic.type}}</span>
      <div class="ability-item-controls">
        <button type="button" class="attack-roll roll-btn" data-item-id="{{_id}}" title="Roll Attack">⚂</button>
        <button type="button" class="equipment-edit" data-item-id="{{_id}}" title="Edit">✎</button>
        <button type="button" class="equipment-delete" data-item-id="{{_id}}" title="Delete">🗑</button>
      </div>
    </div>
    {{/if}}
  {{/each}}

  {{!-- Equipment section --}}
  <div class="section-title">Carried Gear</div>
  {{#each items}}
    {{#if (eq type "equipment")}}
    <div class="equipment-row" data-item-id="{{_id}}">
      <span class="eq-name">{{name}}</span>
      {{#if system.basic.quantity}}
      <span class="eq-qty">×{{system.basic.quantity}}</span>
      {{/if}}
      <div class="ability-item-controls">
        <button type="button" class="equipment-edit" data-item-id="{{_id}}" title="Edit">✎</button>
        <button type="button" class="equipment-delete" data-item-id="{{_id}}" title="Delete">🗑</button>
      </div>
    </div>
    {{/if}}
  {{/each}}

  <div class="add-ability-form card">
    <div class="section-title">Add Equipment</div>
    <div class="ability-form-row">
      <div class="ability-form-field" style="flex:2;">
        <label>Name</label>
        <input type="text" id="new-equipment-name" placeholder="Item name..." />
      </div>
      <div class="ability-form-field" style="flex:1;">
        <label>Quantity</label>
        <input type="number" id="new-equipment-qty" placeholder="1" min="1" style="width:100%;" />
      </div>
    </div>
    <div class="ability-form-field" style="margin-top:8px;">
      <label>Description</label>
      <textarea id="new-equipment-desc" placeholder="Notes about this item..."></textarea>
    </div>
    <button type="button" class="btn-add-equipment">+ Add Equipment</button>
  </div>

</div>